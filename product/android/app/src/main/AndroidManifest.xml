<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Supabase, Google sign-in and profile photos all need the network. The
         debug and profile manifests already grant this; release did not. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Habit and to-do reminders (reminders/ in the Kotlin, and
         docs/REMINDERS.md). Local, so they fire with no network.

         POST_NOTIFICATIONS: asked on onboarding's permission page or when a
         reminder is first set, never at launch.

         Exact alarms: USE_EXACT_ALARM is granted at install on Android 13+,
         which is right for an app whose reminders ring like an alarm clock
         and is sideloaded. Google Play limits it to alarm and calendar apps;
         a Play build would drop it and rely on SCHEDULE_EXACT_ALARM, which
         the code already asks for and falls back from. Below 13 only
         SCHEDULE_EXACT_ALARM exists.

         USE_FULL_SCREEN_INTENT: the Tide Call over the lock screen. Android
         14+ can refuse it; the call then arrives as a heads-up that opens it.

         FOREGROUND_SERVICE, WAKE_LOCK, VIBRATE: the ringing service, which
         plays the tone on the alarm stream and vibrates until answered.

         RECEIVE_BOOT_COMPLETED: alarms are cleared by a reboot and armed
         again from what the phone kept.

         REQUEST_IGNORE_BATTERY_OPTIMIZATIONS: the optional last card on the
         permission page. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <!-- Syncing the to-do list when the connection comes back. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- In-app updates. Tide is sideloaded, so a new release is an APK the
         app downloads itself and hands to the system installer; Android 8+
         also asks the person once, per app, before that is allowed. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <application
        android:label="Tide"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- No launcher entry here: that is one of the aliases below, so
                 the icon can follow the palette. This filter exists for
                 `flutter run`, which launches the first activity whose filter
                 names MAIN + LAUNCHER — without it, that was .LauncherMidnight,
                 and the launch failed once the palette had disabled it. The
                 data scheme keeps the home screen from listing it: a launcher
                 asks for MAIN + LAUNCHER with no data, which this can't match,
                 while flutter_tools only checks the action and category. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <data android:scheme="tide-dev-launch"/>
            </intent-filter>

            <!-- A home-screen widget tap opens this Activity directly
                 (HomeWidgetLaunchIntent targets it by component, not by
                 this action), but the home_widget plugin's own reference
                 setup registers the filter too, so it's kept here rather
                 than relying only on the explicit intent. -->
            <intent-filter>
                <action android:name="es.antonborri.home_widget.action.LAUNCH"/>
            </intent-filter>
        </activity>

        <!-- The launcher icon, one alias per palette (icons from
             tool/brand_assets_test.dart). Exactly one is enabled at a time;
             MainActivity switches them when the app leaves the foreground
             after the palette changes. Midnight is on by default, so a fresh
             install shows the standard icon. -->
        <activity-alias
            android:name=".LauncherMidnight"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherDeepWater"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_deep_water"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherInk"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_ink"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherBlossom"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_blossom"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherPaper"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_paper"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- Today's Habits and Habit Dashboard home-screen widgets. See
             lib/services/home_widget/ for what writes their data, and
             TodayHabitsWidgetProvider.kt / HabitDashboardWidgetProvider.kt
             for how each renders it. -->
        <receiver
            android:name=".TodayHabitsWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_habits_widget_info"/>
        </receiver>
        <receiver
            android:name=".HabitDashboardWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/habit_dashboard_widget_info"/>
        </receiver>
        <receiver
            android:name=".SingleHabitStreakWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/single_habit_streak_widget_info"/>
        </receiver>
        <receiver
            android:name=".TodayTasksWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_tasks_widget_info"/>
        </receiver>
        <receiver
            android:name=".QuickAddWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_add_widget_info"/>
        </receiver>
        <receiver
            android:name=".HabitHeatmapWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/habit_heatmap_widget_info"/>
        </receiver>
        <receiver
            android:name=".WeeklyRecapWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weekly_recap_widget_info"/>
        </receiver>

        <!-- Rows for the scrolling Today, Tasks and Streaks widgets. Only the
             launcher, holding BIND_REMOTEVIEWS, may bind it. -->
        <service
            android:name=".WidgetListService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Reminders: the alarms firing, notification buttons, and every
             event that clears alarms (a reboot, an update, a clock or time-
             zone change) so they can be armed again. Not exported: only the
             system and Tide itself send to it. Android reminders no longer
             go through flutter_local_notifications, whose receivers were
             here; the app cancels what an earlier build scheduled through it
             once, on first launch (AndroidReminderPlatform.create). -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED"/>
            </intent-filter>
        </receiver>

        <!-- Rings a call: the tone swelling on the alarm stream, the
             vibration, and the notification that carries the full-screen
             intent. A short service: it gives up into a missed-reminder
             notification after two minutes, well inside Android 14's limit
             for the type. -->
        <service
            android:name=".reminders.TideCallService"
            android:exported="false"
            android:foregroundServiceType="shortService"/>

        <!-- The Tide Call and the Lighthouse over the lock screen. Its own
             task, kept out of recents, and its own Flutter engine on the
             tideCallMain entry point, so nothing behind the call is
             reachable without unlocking. -->
        <activity
            android:name=".reminders.TideCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="com.example.tide.call"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
        </activity>

        <!-- Shares a downloaded update APK with the system installer. Only
             the update cache is exposed (res/xml/update_paths.xml). -->
        <provider
            android:name=".UpdateFileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths"/>
        </provider>

        <!-- Shares a rendered milestone card with the app it is sent to.
             Only the card cache is exposed (res/xml/share_paths.xml). -->
        <provider
            android:name=".CardShareProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths"/>
        </provider>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- The milestone share sheet only offers an app that is installed,
             and from Android 11 an app cannot see another without asking
             here (CardShare.kt). The intent entry is for finding
             Instagram's story composer among its share targets. -->
        <package android:name="com.whatsapp"/>
        <package android:name="com.whatsapp.w4b"/>
        <package android:name="com.instagram.android"/>
        <intent>
            <action android:name="android.intent.action.SEND"/>
            <data android:mimeType="image/png"/>
        </intent>
    </queries>
</manifest>

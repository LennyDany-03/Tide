<?xml version="1.0" encoding="utf-8"?>
<!-- The grid is a bitmap drawn natively at the widget's own size (see
     WidgetHeatmap.kt), so it fills the card edge to edge at any resize. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/heatmap_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:id="@+id/heatmap_header"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/heatmap_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/manrope_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_heatmap_title"
            android:textColor="@color/tide_bone"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/heatmap_flame"
            android:layout_width="12dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_flame"
            android:visibility="gone" />

        <TextView
            android:id="@+id/heatmap_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:fontFamily="@font/space_grotesk_medium"
            android:includeFontPadding="false"
            android:textColor="@color/tide_lantern"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/heatmap_empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/manrope_medium"
        android:gravity="center"
        android:text="@string/widget_choose_habit"
        android:textColor="@color/tide_silt"
        android:textSize="13sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/heatmap_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />
</LinearLayout>

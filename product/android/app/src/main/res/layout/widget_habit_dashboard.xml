            android:textColor="@color/tide_lantern"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dashboard_row_6"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"

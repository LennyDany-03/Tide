            android:layout_height="wrap_content"
            android:fontFamily="@font/space_grotesk_medium"
            android:textColor="@color/tide_lantern"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dashboard_row_3"
        android:layout_width="match_parent"

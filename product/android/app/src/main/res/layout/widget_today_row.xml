<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_row"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:background="@drawable/widget_tile"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp">

    <ImageView
        android:id="@+id/today_status"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:src="@drawable/widget_check_open" />

    <TextView
        android:id="@+id/today_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:fontFamily="@font/manrope_medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/tide_bone"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_marginStart="8dp"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:background="@drawable/widget_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageView
            android:id="@+id/today_flame"
            android:layout_width="10dp"
            android:layout_height="12dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_flame" />
        <TextView
            android:id="@+id/today_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/space_grotesk_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/tide_silt"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>

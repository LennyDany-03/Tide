<?xml version="1.0" encoding="utf-8"?>
<!-- Free, 4x2. Same fixed-row-slot shape as widget_today_habits.xml — see
     TodayTasksWidgetProvider.kt / WidgetPayload.maxTaskRows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tasks_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_background"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/manrope_medium"
        android:text="@string/widget_tasks_title"
        android:textColor="@color/tide_silt"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tasks_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope_regular"
        android:text="@string/widget_tasks_empty"
        android:textColor="@color/tide_bone"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/tasks_row_1"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/tasks_status_1"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/widget_status_due" />
        <TextView
            android:id="@+id/tasks_title_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/manrope_medium"
            android:maxLines="1"
            android:textColor="@color/tide_bone"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tasks_row_2"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/tasks_status_2"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/widget_status_due" />
        <TextView
            android:id="@+id/tasks_title_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/manrope_medium"
            android:maxLines="1"
            android:textColor="@color/tide_bone"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tasks_row_3"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/tasks_status_3"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/widget_status_due" />
        <TextView
            android:id="@+id/tasks_title_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/manrope_medium"
            android:maxLines="1"
            android:textColor="@color/tide_bone"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tasks_row_4"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/tasks_status_4"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/widget_status_due" />
        <TextView
            android:id="@+id/tasks_title_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/manrope_medium"
            android:maxLines="1"
            android:textColor="@color/tide_bone"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tasks_row_5"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/tasks_status_5"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/widget_status_due" />
        <TextView
            android:id="@+id/tasks_title_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/manrope_medium"
            android:maxLines="1"
            android:textColor="@color/tide_bone"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>

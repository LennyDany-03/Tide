<?xml version="1.0" encoding="utf-8"?>
<!-- Shared locked-state tile for every Pro widget (Habit Dashboard, Habit
     Heatmap, Weekly Recap, extra Streak copies): one tap target straight
     into the Upgrade paywall, title set at runtime by each provider through
     LockedWidgetViews.build. Not a dimmed version of the real widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/locked_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/widget_lock_badge">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_lock" />
    </FrameLayout>

    <TextView
        android:id="@+id/locked_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope_medium"
        android:textColor="@color/tide_bone"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/manrope_medium"
        android:text="@string/widget_upgrade_to_pro"
        android:textColor="@color/tide_lantern"
        android:textSize="12sp" />
</LinearLayout>

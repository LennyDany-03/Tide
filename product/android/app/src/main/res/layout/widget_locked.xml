<?xml version="1.0" encoding="utf-8"?>
<!-- Shared locked-state tile for every Pro widget (Habit Dashboard, Habit
     Heatmap, Weekly Recap): one tap target straight into the Upgrade
     paywall, title set at runtime by each provider via lockedTitle in
     WidgetPayloadReader.kt. Not a dimmed version of the real widget — see
     HabitDashboardWidgetProvider.kt for why. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/locked_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_background"
    android:gravity="center"
    android:padding="16dp">

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/ic_widget_lock" />

    <TextView
        android:id="@+id/locked_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope_medium"
        android:textColor="@color/tide_bone"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/manrope_regular"
        android:text="@string/widget_upgrade_to_pro"
        android:textColor="@color/tide_lantern"
        android:textSize="12sp" />
</LinearLayout>

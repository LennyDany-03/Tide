<?xml version="1.0" encoding="utf-8"?>
<!-- Static sample for the widget picker. Keep in visual sync with
     widget_single_habit_streak.xml by hand. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="46dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_flame" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/space_grotesk_medium"
            android:includeFontPadding="false"
            android:text="12"
            android:textColor="@color/tide_bone"
            android:textSize="34sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/manrope_medium"
            android:text="@string/widget_day_streak"
            android:textColor="@color/tide_silt"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/manrope_medium"
            android:gravity="center"
            android:maxLines="1"
            android:text="Morning water"
            android:textColor="@color/tide_lantern"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:contentDescription="@null"
        android:src="@drawable/widget_check_done" />
</FrameLayout>

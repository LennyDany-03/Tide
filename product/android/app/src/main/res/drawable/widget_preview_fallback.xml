<?xml version="1.0" encoding="utf-8"?>
<!-- previewImage fallback for pre-Android-12 pickers, which can't inflate
     previewLayout and would otherwise fall back to a blank white card with
     the launcher icon. This is the same blank-card shape, just on-brand
     (Midnight's rounded card, not a plain white rectangle) — the real,
     content-accurate preview is previewLayout, read by every picker that
     matters here (see widget_today_habits_preview.xml /
     widget_habit_dashboard_preview.xml). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/widget_card_background" />
    <item
        android:width="48dp"
        android:height="48dp"
        android:gravity="center"
        android:drawable="@mipmap/ic_launcher" />
</layer-list>

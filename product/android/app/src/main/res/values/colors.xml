<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Midnight's page colour. The window is painted this before Flutter
         draws its first frame, so launch goes dark to dark into the splash
         with no white flash. It is also the adaptive icon's background. -->
    <color name="tide_ground">#FF05080B</color>

    <!-- Home-screen widgets render outside the Flutter engine, so they can't
         read TideColors at runtime. These are Midnight's widget colours, and
         the layouts and drawables that use them are Midnight's. Every other
         palette gets generated copies (values/widget_palettes.xml and the
         *_<palette id> layouts and drawables), written from
         lib/theme/tide_palette.dart by `flutter test
         tool/widget_palettes_test.dart`; WidgetTheme.kt picks the copy for
         the palette the app last reported. Edit a widget here, then rerun
         the tool. -->
    <color name="tide_shelf">#FF0C1217</color>
    <color name="tide_shoal">#FF17272D</color>
    <color name="tide_bone">#FFE8F1F6</color>
    <color name="tide_silt">#FF7F8E99</color>
    <color name="tide_lantern">#FF45D0FF</color>
    <color name="tide_on_lantern">#FF02121A</color>
    <color name="tide_coral">#FFE0675E</color>
    <color name="tide_rest">#0AFFFFFF</color>

    <!-- The flame's ramp: TidePalettes.midnight flare and ember. -->
    <color name="tide_flare">#FFC8F3FF</color>
    <color name="tide_ember">#FF1A9BF0</color>

    <!-- The card's hairline edge, so a widget still has a silhouette on a
         dark wallpaper. -->
    <color name="tide_card_edge">#14E8F1F6</color>

    <!-- A list row's raised tile, and the soft pill fills behind a lantern
         or coral label. -->
    <color name="tide_tile">#FF141E25</color>
    <color name="tide_lantern_soft">#2645D0FF</color>
    <color name="tide_coral_soft">#2EE0675E</color>

    <!-- Heatmap tiers, shared by the native renderer (WidgetHeatmap.kt), the
         dashboard's day squares and the picker's sample grid. An empty day
         is a clearly visible tile, not near-black, so the grid reads as a
         grid even for a habit started this week. -->
    <color name="tide_cell_empty">#FF18222A</color>
    <color name="tide_cell_rest">#FF121A20</color>
    <color name="tide_cell_1">#FF174A5E</color>
    <color name="tide_cell_2">#FF1F7899</color>
    <color name="tide_cell_3">#FF30A9D6</color>
    <color name="tide_cell_4">#FF45D0FF</color>
    <!-- The rest of this week on the recap strip, and the core of a flame
         that has gone out. -->
    <color name="tide_cell_future">#70121A20</color>
    <color name="tide_flame_out_core">#FF2A3B44</color>
</resources>

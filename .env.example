# Copy to .env and fill in. Read at build time:
#   flutter run --dart-define-from-file=.env
# Only public values belong here — never the Supabase secret/service_role key
# or the Google client secret.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Google Cloud → Clients → the *Web application* client ID (not the Android one).
GOOGLE_WEB_CLIENT_ID=

# Only for an iOS build.
GOOGLE_IOS_CLIENT_ID=

# Razorpay needs nothing here, deliberately.
#
# The key id comes back with the order from the `razorpay-create-order` Edge
# Function, so rotating keys is a dashboard change rather than an app release.
# The key secret and the webhook secret are set once with
# `supabase secrets set` and never leave the project — see
# supabase/functions/README.md.

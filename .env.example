# Copy to .env and fill in. Read at build time:
#   flutter run --dart-define-from-file=.env
# Only public values belong here — never the Supabase secret/service_role key
# or the Google client secret.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Google Cloud → Clients → the *Web application* client ID (not the Android one).
GOOGLE_WEB_CLIENT_ID=

# Only for an iOS build.
GOOGLE_IOS_CLIENT_ID=
